#!/bin/sh
# Pin, update and inspect GitHub Actions. Requires curl and jq.
set -eu

usage() {
    cat <<'EOF'
Usage: pingha [options]
  -p, --pin          Pin actions to their current ref's commit SHA.
  -u, --update       Pin actions to the latest tag returned by GitHub.
  -i, --info         Show actions, current versions, pin and update status.
  -r, --review       Show all commits and the full diff to the latest tag.
  -d, --dependabot   Create a GitHub Actions Dependabot configuration.
  -h, --help         Show this help.
Environment: GITHUB_TOKEN (GitHub authentication), NO_COLOR (disable colors).
Lookups, including failures, are cached for the duration of each invocation.
Review requires git, runs before other modes, and does not change workflows.
When combined with --update, a failed review prevents updates.
EOF
}

modes=
review_requested=false
for option do
    case "$option" in
        -p|--pin) modes="$modes pin" ;;
        -u|--update) modes="$modes update" ;;
        -i|--info) modes="$modes info" ;;
        -r|--review) review_requested=true ;;
        -d|--dependabot) modes="$modes dependabot" ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$option" >&2; exit 1 ;;
    esac
done
if "$review_requested"; then modes=" review$modes"; fi
[ -n "$modes" ] || { usage; exit 0; }
dependencies='jq curl'
if "$review_requested"; then dependencies="$dependencies git"; fi
for dependency in $dependencies; do
    command -v "$dependency" >/dev/null 2>&1 || {
        printf 'pingha: required command not found: %s\n' "$dependency" >&2; exit 1;
    }
done
cache=$(mktemp -d "${TMPDIR:-/tmp}/pingha.XXXXXXXX")
pending=
trap 'rm -rf "$cache"; [ -z "$pending" ] || rm -f "$pending"' 0
trap 'exit 1' HUP INT TERM
red= green= reset=
if [ -z "${NO_COLOR+x}" ] && { [ -t 1 ] || [ "${CLICOLOR_FORCE:-0}" != 0 ]; }; then
    red=$(printf '\033[31m'); green=$(printf '\033[32m'); reset=$(printf '\033[0m')
fi

cache_entry() (
    key=$(printf '%s' "$1" | cksum | tr ' ' -)
    entry=$cache/$key
    while [ -f "$entry.key" ] && [ "$(cat "$entry.key")" != "$1" ]; do entry=$entry.x; done
    printf '%s' "$1" > "$entry.key"
    printf '%s\n' "$entry"
)

# Cache resolved values and failures; subshell variables cannot clobber the caller.
resolve() (
    repo=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    if [ -z "$2" ]; then
        endpoint="$repo/tags?per_page=1"; filter='.[0] | [.commit.sha, .name]'
    else
        ref=$(printf '%s' "$2" | jq -sRr @uri)
        endpoint="$repo/commits/$ref"; filter='[.sha]'
    fi
    entry=$(cache_entry "$endpoint")
    [ ! -f "$entry.failed" ] || return 1
    if [ ! -f "$entry" ]; then
        [ ! -f "$cache/limited" ] || return 1
        set -- "https://api.github.com/repos/$endpoint"
        if [ -n "${GITHUB_TOKEN:-}" ]; then set -- "$@" -H "Authorization: Bearer $GITHUB_TOKEN"; fi
        code=$(curl -sSL --connect-timeout 10 --max-time 30 -H 'Accept: application/vnd.github+json' \
            -o "$entry.body" -w '%{http_code}' "$@") || code=000
        filter="$filter"' | select(.[0] | test("^[a-fA-F0-9]{40}$")) | select(length == 1 or (.[1] | test("^[^[:space:]]+$"))) | .[0] |= ascii_downcase | @tsv'
        if [ "$code" != 200 ] || ! jq -er "$filter" "$entry.body" > "$entry" 2>/dev/null; then
            message=$(jq -r '.message // "No valid commit/tag"' "$entry.body" 2>/dev/null) || message='No valid commit/tag'
            printf 'pingha: HTTP %s: %s: %s\n' "$code" "$1" "$message" >&2
            touch "$entry.failed" "$cache/failed"
            case "$code:$message" in 429:*|403:*rate*limit*|403:*abuse*) touch "$cache/limited" ;; esac
            return 1
        fi
    fi
    cat "$entry"
)

# Fetch immutable commits without checking out or running action code. Using Git
# avoids API limits and compares the actual trees even when histories diverge.
review() (
    # A caller running from a Git hook may have exported its repository paths.
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE \
        GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE
    repo=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    range=$(cache_entry "review:$repo:$2:$3")
    if [ -f "$range.done" ]; then
        printf 'Same repository and commit range already reviewed above.\n'; return 0
    fi
    entry=$(cache_entry "git:$repo")
    review_git() {
        git --no-pager --git-dir="$entry.git" -c core.hooksPath=/dev/null \
            -c color.ui=false -c log.showSignature=false "$@"
    }
    export GIT_TERMINAL_PROMPT=0 LC_ALL=C
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        cat > "$cache/askpass" <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\n' x-access-token ;;
    *Password*) printf '%s\n' "$GITHUB_TOKEN" ;;
    *) exit 1 ;;
esac
EOF
        chmod 700 "$cache/askpass" || return 1
        GIT_ASKPASS=$cache/askpass; export GIT_ASKPASS
    fi
    if [ ! -d "$entry.git" ]; then
        review_git init --bare --quiet --template= || return 1
    fi
    # Fetch the new commit first; its history normally contains the old commit.
    for commit in "$3" "$2"; do
        [ ! -f "$entry.$commit.failed" ] || return 1
        if ! review_git cat-file -e "$commit^{commit}" 2>/dev/null; then
            if ! review_git -c credential.helper= fetch --quiet --no-tags --no-recurse-submodules \
                "https://github.com/$repo.git" "$commit"; then
                touch "$entry.$commit.failed"; return 1
            fi
        fi
    done
    printf 'Compare: https://github.com/%s/compare/%s..%s\n' "$repo" "$2" "$3"
    if review_git merge-base --is-ancestor "$2" "$3"; then
        :
    else
        status=$?; [ "$status" -eq 1 ] || return 1
        printf '\nWARNING: latest tag does not descend from the current commit.\n'
        printf 'Commits removed from the current history:\n'
        review_git log --reverse --topo-order --format=fuller --no-notes "$3..$2" -- || return 1
    fi
    printf '\nCommits added since the current reference:\n'
    review_git log --reverse --topo-order --format=fuller --no-notes "$2..$3" -- || return 1
    printf '\nFull diff (current commit -> latest tag):\n'
    review_git diff --no-ext-diff --no-textconv --no-renames --ignore-submodules=none \
        --binary --full-index --stat --patch "$2" "$3" -- || return 1
    touch "$range.done"
)

# Scan and rewrite only scalar uses: lines, skipping YAML block strings.
workflow() {
    awk -v edits="$1" '
    BEGIN { FS = OFS = "\t"; while (edits && (getline < edits) > 0) { sha[$1] = $2; tag[$1] = $3 } }
    {
        original = $0; sub(/\r$/, ""); cr = length(original) > length($0) ? "\r" : ""
        match($0, /[^ \t]/); indent = RSTART
        if (block && indent && indent <= block) block = 0
        content = $0; sub(/^[ \t]*/, "", content)
        if (!block && content !~ /^#/ && content ~ /:[ \t]*[|>][0-9+-]*[ \t]*(#.*)?$/) block = indent
        if (!block && match($0, /^[ \t]*(-[ \t]+)?uses:[ \t]*/)) {
            prefix = substr($0, 1, RLENGTH); rest = substr($0, RLENGTH + 1)
            quote = substr(rest, 1, 1); if (quote != "\047" && quote != "\"") quote = ""
            rest = substr(rest, length(quote) + 1)
            if (match(rest, /^[^ \t\047\"]+/)) {
                action = substr(rest, 1, RLENGTH); comment = substr(rest, RLENGTH + length(quote) + 1)
                if (action ~ /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.\/-]+@[^@]+$/ &&
                    (!quote || substr(rest, RLENGTH + 1, 1) == quote) && comment ~ /^[ \t]*(#.*)?$/) {
                    if (!edits) print FNR, action, comment
                    if (FNR in sha) {
                        sub(/@[^@]+$/, "@" sha[FNR], action)
                        sub(/^[ \t]*#[ \t]*/, "", comment)
                        sub(/^(v[0-9]|[0-9]+\.[0-9])[A-Za-z0-9_.\/+\-]*([ \t]+|$)/, "", comment)
                        $0 = prefix quote action quote " # " tag[FNR] (comment ? " " comment : "") cr
                        original = $0
                    }
                }
            }
        }
        if (edits) print original
    }' "$file"
}

for mode in $modes; do
    if [ "$mode" = dependabot ]; then
        mkdir -p .github
        if [ -e .github/dependabot.yml ] || [ -e .github/dependabot.yaml ]; then
            printf 'Keeping existing Dependabot configuration.\n'; continue
        fi
        printf '%s\n' 'version: 2' 'updates:' '  - package-ecosystem: "github-actions"' \
            '    directory: "/"' '    schedule:' '      interval: "weekly"' \
            '    commit-message:' '      prefix: "actions"' '    labels:' \
            '      - "dependencies"' '      - "github-actions"' > .github/dependabot.yml
        printf 'Created .github/dependabot.yml; review and commit it.\n'; continue
    fi
    [ -d .github/workflows ] || { printf 'No .github/workflows directory found.\n'; continue; }
    [ "$mode" != info ] || printf 'ACTION\tCURRENT\tPIN\tNEXT\n'
    : > "$cache/seen"
    for file in .github/workflows/*.yml .github/workflows/*.yaml; do
        [ -f "$file" ] || continue
        workflow '' > "$cache/refs"
        : > "$cache/edits"
        while IFS="$(printf '\t')" read -r number action comment; do
            path=${action%@*}; ref=${action##*@}; owner=${path%%/*}; rest=${path#*/}; repo=$owner/${rest%%/*}
            pinned=false; color=$red; state=unpinned
            if printf '%s\n' "$ref" | grep -Eq '^[a-fA-F0-9]{40}$'; then pinned=true; color=$green; state=pinned; fi
            [ "$mode:$pinned" != pin:true ] || continue
            if [ "$mode" = info ] || [ "$mode" = review ]; then
                grep -Fxq -e "$action" "$cache/seen" && continue
                printf '%s\n' "$action" >> "$cache/seen"
            fi
            target=; [ "$mode" != pin ] || target=$ref
            if result=$(resolve "$repo" "$target"); then
                sha=${result%%[[:space:]]*}; tag=${result#*"$(printf '\t')"}; [ "$mode" != pin ] || tag=$ref
                current=$(printf '%s' "$ref" | tr '[:upper:]' '[:lower:]')
                if [ "$mode" = info ] || [ "$mode" = review ]; then
                    if ! "$pinned"; then
                        if [ "$ref" = "$tag" ]; then current=$sha; else current=$(resolve "$repo" "$ref") || { current=unknown; touch "$cache/failed"; }; fi
                    fi
                    next="update to $tag"; [ "$current" != "$sha" ] || next='up to date'
                    [ "$current" != unknown ] || next=unknown
                    if [ "$mode" = review ]; then
                        printf '\nReview: %s -> %s (%s)\n' "$action${comment:+ $comment}" "$tag" "$sha"
                        if [ "$current" = unknown ]; then
                            printf 'Review unavailable: could not resolve the current reference.\n'
                        elif [ "$current" = "$sha" ]; then
                            printf 'Up to date; no changes.\n'
                        elif ! review "$repo" "$current" "$sha"; then
                            printf 'pingha: incomplete review for %s (%s -> %s)\n' "$repo" "$current" "$sha" >&2
                            touch "$cache/failed"
                        fi
                    fi
                elif [ "$current" != "$sha" ]; then
                    printf '%s\t%s\t%s\n' "$number" "$sha" "$tag" >> "$cache/edits"
                    printf '%s: %s -> %s (%s)\n' "$file" "$action" "$tag" "$sha"
                fi
            else
                touch "$cache/failed"; next=unknown
            fi
            if [ "$mode" = info ]; then
                version=$ref; [ -z "$comment" ] || version="$ref $comment"
                printf '%s\t%s\t%s%s%s\t%s\n' "$path" "$version" "$color" "$state" "$reset" "$next"
            fi
        done < "$cache/refs"
        if [ -s "$cache/edits" ]; then
            pending=$(mktemp "$file.XXXXXXXX")
            cp -p "$file" "$pending"
            workflow "$cache/edits" > "$pending"
            mv "$pending" "$file"
            pending=
        fi
    done
    if [ "$mode" = review ] && [ -f "$cache/failed" ]; then exit 1; fi
done
[ ! -f "$cache/failed" ]
